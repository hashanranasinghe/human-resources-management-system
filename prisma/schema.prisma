generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  EMPLOYEE
  JUNIOR_EMPLOYEE
}

model Position {
  id        Int        @default(autoincrement())
  refId     String     @id @unique
  title     String     @unique
  level     Int        // To indicate hierarchy level
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations
  employees Employee[]
}

model Employee {
  id           Int        @default(autoincrement())
  refId        String     @id @unique
  name         String
  positionId   String?     // Reference to Position
  hireDate     String   
  role         Role
  email        String     @unique
  departmentId String?
  password     String
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  // Relations
  position     Position?    @relation(fields: [positionId], references: [refId])
  department   Department? @relation("department", fields: [departmentId], references: [refId])
  managedDepts Department[] @relation("manager")
  createdDepts Department[] @relation("creator")
  attendance   Attendance[]
}

model Department {
  id        Int        @default(autoincrement())
  refId     String     @id @unique
  name      String     @unique
  managerId String
  creatorId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations
  manager   Employee   @relation("manager", fields: [managerId], references: [refId])
  creator   Employee   @relation("creator", fields: [creatorId], references: [refId])
  employees Employee[] @relation("department")
}

model Attendance {
  id         Int               @default(autoincrement())
  refId      String            @id @unique
  date       String         
  employeeId String         
  timeIn     String?       
  timeOut    String?         
  events     AttendanceEvent[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  
  // Relations
  employee   Employee          @relation(fields: [employeeId], references: [refId])
}

model AttendanceEvent {
  id           Int        @default(autoincrement())
  refId        String     @id @unique
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [refId])
  eventType    EventType
  eventTime    String   
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum EventType {
  TIME_IN
  TIME_OUT
  BREAK_START
  BREAK_END
}