generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  INTERN
}

model Employee {
  refId        String         @id @default(uuid()) @unique
  name         String
  position     String
  hireDate     String
  role         Role
  email        String         @unique
  departmentId String?
  department   Department?    @relation("department", fields: [departmentId], references: [refId])
  password     String
  manager      Department[]   @relation("manager")
  creator      Department[]   @relation("creator")
  Attendance   Attendance[]   @relation("attendance")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Employeee    LeaveRequest[] @relation("Employeee")
  ApprovedBy   LeaveRequest[] @relation("ApprovedBy")
}

model Department {
  refId     String     @id @default(uuid()) @unique
  name      String
  managerId String
  creatorId String
  manager   Employee   @relation("manager", fields: [managerId], references: [refId])
  creator   Employee   @relation("creator", fields: [creatorId], references: [refId])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Employee  Employee[] @relation("department")
}

model Attendance {
  refId      String            @id @default(uuid()) @unique
  employeeId String
  employee   Employee          @relation("attendance", fields: [employeeId], references: [refId])
  timeIn     String
  timeOut    String
  events     AttendanceEvent[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model AttendanceEvent {
  refId        String     @id @default(uuid()) @unique
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [refId])
  eventType    EventType
  eventTime    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum EventType {
  TIME_IN
  TIME_OUT
}

model LeaveType {
  refId       String  @id @default(uuid()) @unique
  name        String
  description String?

  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  refId         String        @id @default(uuid()) @unique
  employeeId    String
  leaveTypeId   String
  leaveType     LeaveType     @relation(fields: [leaveTypeId], references: [refId])
  startDate     DateTime
  endDate       DateTime?
  leaveDuration LeaveDuration
  status        LeaveStatus   @default(PENDING)
  approvedById  String
  employee      Employee      @relation("Employeee", fields: [employeeId], references: [refId])
  approvedBy    Employee      @relation("ApprovedBy", fields: [approvedById], references: [refId])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum LeaveDuration {
  SHORT_LEAVE
  HALF_DAY
  FULL_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
